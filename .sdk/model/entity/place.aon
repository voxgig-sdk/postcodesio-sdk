pe\":\"string\"},\"region\":{\"description\":\"European Region (formerly Government Office Region) containing this place\",\"example\":\"Wales\",\"title\":\"Region\",\"type\":\"string\"}},\"required\":[\"code\",\"name_1\",\"name_1_lang\",\"name_2\",\"name_2_lang\",\"local_type\",\"outcode\",\"county_unitary\",\"county_unitary_type\",\"district_borough\",\"region\",\"country\",\"longitude\",\"latitude\",\"eastings\",\"northings\",\"min_eastings\",\"min_northings\",\"max_eastings\",\"max_northings\"],\"title\":\"Place\",\"type\":\"object\"},\"status\":{\"enum\":[200],\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"status\",\"result\"],\"title\":\"Place Response\",\"type\":\"object\"}}},\"description\":\"Successfully retrieved a random place\"}},\"securitySource\":\"unspecified\"}"
