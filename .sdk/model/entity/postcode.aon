                orig: "longitude"
                reqd: false
                type: "`$NUMBER`"
              }
              {
                example: "SW1A 2AA"
                kind: "query"
                name: "query"
                orig: "query"
                reqd: false
                type: "`$ANY`"
              }
              {
                example: 500
                kind: "query"
                name: "radius"
                orig: "radius"
