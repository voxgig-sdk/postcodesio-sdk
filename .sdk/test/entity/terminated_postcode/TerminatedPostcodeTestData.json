                          "postcode": {
                            "description": "UK postal code format that has been terminated. Follows the standard format of 2-4 character outward code, a space, then 3-character inward code.",
                            "example": "SW1A 2AA",
                            "pattern": "^[A-Z]{1,2}[0-9][A-Z0-9]? [0-9][A-Z]{2}$",
                            "title": "Postcode",
                            "type": "string"
                          },
                          "year_terminated": {
